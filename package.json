{
  "name": "@cavcrosby/opencode-rename-export",
  "version": "2.0.0",
  "description": "OpenCode plugin that renames OpenCode TUI session exports using a configurable filename format",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavcrosby/opencode-rename-export.git"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --declaration --outDir ./dist",
    "test": "tsx --test ./src/plugin.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
